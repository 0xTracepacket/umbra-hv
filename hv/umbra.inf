;
; umbra.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
CatalogFile = umbra.cat
DriverVer   = 01/01/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
umbra.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = HypervisorInstall,*PNP0C01

[HypervisorInstall.NT]
CopyFiles = DriversCopyFiles

[HypervisorInstall.NT.Services]
AddService = umbra,0x00000002,HypervisorService

[DriversCopyFiles]
umbra.sys,,,0x00000040

[HypervisorService]
DisplayName    = %ServiceName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\umbra.sys

[Strings]
ProviderName      = "umbra"
ManufacturerName  = "umbra"
DeviceName        = "umbra hypervisor"
ServiceName       = "umbra"
DiskName          = "umbra source"
